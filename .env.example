# 입모아(IP-MOA) 환경 변수 — 값은 아직 채우지 않는다(프로젝트 미생성).
# 복사해서 .env.local 을 만들고 값을 채우면 보호자 경로가 동작한다.
# 대상자 화면의 고정 문장 발화는 이 값들이 없어도 단말에서 동작해야 한다.

# --- Supabase (Auth · Postgres · Storage · Realtime) ---
# NEXT_PUBLIC_* 만 브라우저에 노출된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마라.
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs (TTS · 음성 클로닝) — 서버(src/services)에서만 사용 ---
# CRITICAL: 이 키는 클라이언트 번들에 들어가면 안 된다.
ELEVENLABS_API_KEY=
