# 서버 전용 키(ELEVENLABS_API_KEY, SUPABASE_SERVICE_ROLE_KEY)에는 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.

# ElevenLabs API 키 — 서버 전용 (src/services/에서만 사용)
ELEVENLABS_API_KEY=
# 프리셋 목소리로 쓸 ElevenLabs voice_id
ELEVENLABS_PRESET_VOICE_ID=
# Supabase 프로젝트 URL — 브라우저 공개 가능
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon 키 — 브라우저 공개 가능 (RLS로 보호)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role 키 — 서버 전용, RLS 우회 권한
SUPABASE_SERVICE_ROLE_KEY=
